# AI-OS .dockerignore
# Excludes files/directories from Docker build context to reduce image size and build time

# Git
.git
.gitignore
.gitattributes

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Python
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.coverage
.tox/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
pip-wheel-metadata/
.venv/
venv/
env/
virtualenv/
*.egg

# Node.js / npm
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.yarn/
.pnp/
.pnp.js

# Build artifacts
*.log
*.tmp
*.temp
.tmp/
.temp/
dist/
build/
out/
*.bundle.js
*.bundle.js.map

# Test artifacts
coverage/
.nyc_output/
junit.xml
pytest-*.xml
*.test.ts
*.spec.ts

# Configuration (local/secret files)
.env
.env.local
.env.*.local
config/secrets.yaml
config/mcp/*.json
config/capabilities/*.yaml
config/*.json

# Data directories
data/
*.sqlite
*.sqlite3
*.db
*.duckdb

# Logs
logs/
*.log

# OS
Thumbs.db
ehthumbs.db
Desktop.ini

# CI/CD
.github/
.gitlab/
.bitbucket-pipelines.yml
Jenkinsfile
.travis.yml
.circleci/
azure-pipelines.yml

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore
.docker/

# Kubernetes
k8s/
*.k8s.yaml
helm/
*.helm.yaml

# Terraform / IaC
*.tf
*.tfstate
*.tfvars
.terraform/

# Archives
*.tar
*.tar.gz
*.tgz
*.zip
*.rar

# Misc
*.bak
*.backup
*.orig
*.rej
.cache/
.tmp/
temp/
*.swp

# AI-OS specific
*.hermes_build_sha
.install_method
.hermes/

# Hermes agent (separate project, not part of AI-OS runtime)
hermes-agent/

# M13 External Integrations (user resources - not in build)
supabase/
n8n/
obsidian/
graphify/
claude-mem/

# Architecture documentation (not needed at runtime)
architecture/
*.pdf